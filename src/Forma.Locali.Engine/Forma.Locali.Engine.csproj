<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Forma.Locali</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Roslyn is the installed SDK's own compiler at run time, so this is reference-only, names the oldest API the engine uses, and stays out of whatever references the engine. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <!-- MSBuildLocator loads MSBuild from the installed SDK, so these must be reference-only. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="NuGet.Frameworks" Version="6.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\formaui-net\src\Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\..\formaui-net\src\Framework\Forma.Framework.Localization.Json\Forma.Framework.Localization.Json.csproj" />
    </ItemGroup>

</Project>
