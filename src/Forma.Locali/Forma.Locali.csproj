<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AssemblyName>locali</AssemblyName>
        <RootNamespace>Forma.Locali</RootNamespace>
    </PropertyGroup>

    <!-- The tool a repository pins in its manifest; the command is the assembly's name, and the package is the project's. -->
    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>locali</ToolCommandName>
        <PackageId>formaui-net.Locali</PackageId>
        <Version>1.0.0-preview.7</Version>
        <Authors>Eyal Alon</Authors>
        <Description>A linter for Forma.Framework.Localization: reads locale files against the runtime's rules and every IStringLocale callsite against what the runtime will do with it.</Description>
        <PackageTags>localization;linter;blazor;forma</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Forma.Locali</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Forma.Locali</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- Roslyn is the installed SDK's own compiler at run time, so this is reference-only and names the oldest API the linter uses. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" PrivateAssets="build;buildTransitive" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.0.0" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    </ItemGroup>

    <!-- MSBuildLocator loads MSBuild from the installed SDK, so these must be reference-only. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="NuGet.Frameworks" Version="6.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Forma\src\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\..\Forma\src\Forma.Framework\Forma.Framework.Localization.Json\Forma.Framework.Localization.Json.csproj" />
    </ItemGroup>

</Project>
