<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>Forma.Locali.Tests</RootNamespace>
        <NoWarn>CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    </ItemGroup>

    <!-- The scratch folder and the locale file text are the engine tests' own, compiled here too rather than copied. -->
    <ItemGroup>
        <Compile Include="..\Forma.Locali.Engine.Tests\Support\TempDirectory.cs" Link="Support\TempDirectory.cs" />
        <Compile Include="..\Forma.Locali.Engine.Tests\Support\Documents\LocalizationFileFakeData.cs" Link="Support\Documents\LocalizationFileFakeData.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\formaui-net\src\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\src\Forma.Locali.Engine\Forma.Locali.Engine.csproj" />
        <ProjectReference Include="..\..\src\Forma.Locali\Forma.Locali.csproj" />
    </ItemGroup>

</Project>
