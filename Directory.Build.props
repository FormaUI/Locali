<Project>

    <!--
        Forma Build Properties
        
        Shared properties for all Forma projects.
    -->

    <PropertyGroup>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <!-- Reports the .editorconfig IDE* code-style severities from the compiler, not just the IDE. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- A build on GitHub Actions maps its source paths to the repository's, as Source Link resolves them. -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
